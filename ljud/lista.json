  "text": "Vilken bokstav börjar tum på?",
  "grupp": "Vilken bokstav?"
 },
 {
  "id": "forsta-tår",
  "text": "Vilken bokstav börjar tår på?",
  "grupp": "Vilken bokstav?"
 },
 {
  "id": "mening-01",
  "text": "Nils ser en sol.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-02",
  "text": "Mamma har en mus.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-03",
  "text": "Pappa har en bil.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-04",
  "text": "En ko går på väg.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-05",
  "text": "Katten sover.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-06",
  "text": "Hunden är glad.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-07",
  "text": "Jag ser ett torn.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-08",
  "text": "Tornet är högt.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-09",
  "text": "Solen är gul.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-10",
  "text": "Ett lamm leker.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-11",
  "text": "Fisken simmar.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-12",
  "text": "Ugglan sitter i ett träd.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-13",
  "text": "En älg står i skogen.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-14",
  "text": "Nils har en boll.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-15",
  "text": "Bollen är röd.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-16",
  "text": "Mamma läser en bok.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-17",
  "text": "Pappa äter ost.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-18",
  "text": "Det regnar ute.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-19",
  "text": "Snön är vit.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-20",
  "text": "En båt på sjön.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-21",
  "text": "Grisen är rosa.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-22",
  "text": "Hästen springer.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-23",
  "text": "Draken flyger.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-24",
  "text": "Roboten går.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-25",
  "text": "Kungen har ett slott.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-26",
  "text": "Raketen åker upp.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-27",
  "text": "Nils bygger ett torn.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-28",
  "text": "Blocket är av trä.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-29",
  "text": "Stenen är tung.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-30",
  "text": "Guld är gult.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-31",
  "text": "Diamanten glittrar.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-32",
  "text": "Ekorren äter.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-33",
  "text": "Räven är röd.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-34",
  "text": "Björnen sover.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-35",
  "text": "Myran är liten.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-36",
  "text": "Snigeln är långsam.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-37",
  "text": "Grodan hoppar.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-38",
  "text": "Fågeln sjunger.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-39",
  "text": "Vi äter glass.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-40",
  "text": "Jag har en mössa.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-41",
  "text": "Nils har en hatt.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-42",
  "text": "Mamma har en kaka.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-43",
  "text": "En nalle i sängen.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-44",
  "text": "Lampan lyser.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-45",
  "text": "Dörren är öppen.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-46",
  "text": "Kaninen äter en morot.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-47",
  "text": "Tårtan är god.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-48",
  "text": "Nils gräver i sanden.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-49",
  "text": "Hinken är full.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-50",
  "text": "Månen lyser.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-51",
  "text": "Molnet är grått.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-52",
  "text": "Vinden blåser.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-53",
  "text": "En kula rullar.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-54",
  "text": "Spiken är av järn.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-55",
  "text": "Skatten är av guld.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-56",
  "text": "Nils hittar en skatt.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-57",
  "text": "Jag kan läsa.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-58",
  "text": "Det är kul att läsa.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-59",
  "text": "Bussen kör.",
  "grupp": "Meningar"
 },
 {
  "id": "mening-60",
  "text": "Cykeln är ny.",
  "grupp": "Meningar"
 },
 {
  "id": "berom-01",
  "text": "Wow!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-02",
  "text": "Superbra!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-03",
  "text": "Kanon!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-04",
  "text": "Toppen, Nils!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-05",
  "text": "Du är grym!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-06",
  "text": "Snyggt grävt!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-07",
  "text": "Pang! Där gick blocket!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-08",
  "text": "Bra lyssnat!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-09",
  "text": "Du läste rätt!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-10",
  "text": "Ett block till!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-11",
  "text": "Yes!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-12",
  "text": "Helt rätt!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-13",
  "text": "Vilken läsare!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-14",
  "text": "Nu blir tornet högre!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-15",
  "text": "Snabbt och rätt!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-16",
  "text": "Där satt den!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-17",
  "text": "Du klarade det!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-18",
  "text": "Härligt!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-19",
  "text": "Precis!",
  "grupp": "Beröm"
 },
 {
  "id": "berom-20",
  "text": "Mästerligt!",
  "grupp": "Beröm"
 },
 {
  "id": "hjalp-01",
  "text": "Titta noga.",
  "grupp": "Hjälp"
 },
 {
  "id": "hjalp-02",
  "text": "Lyssna en gång till.",
  "grupp": "Hjälp"
 },
 {
  "id": "hjalp-03",
  "text": "Nästan! Prova igen.",
  "grupp": "Hjälp"
 },
 {
  "id": "hjalp-04",
  "text": "Ingen fara, prova igen.",
  "grupp": "Hjälp"
 },
 {
  "id": "hjalp-05",
  "text": "Tryck på högtalaren om du vill höra igen.",
  "grupp": "Hjälp"
 },
 {
  "id": "hjalp-06",
  "text": "Ta det lugnt. Du har gott om tid.",
  "grupp": "Hjälp"
 },
 {
  "id": "hjalp-07",
  "text": "Titta, den lyser!",
  "grupp": "Hjälp"
 },
 {
  "id": "hjalp-08",
  "text": "Prova ett annat block.",
  "grupp": "Hjälp"
 },
 {
  "id": "hjalp-09",
  "text": "Bra försök!",
  "grupp": "Hjälp"
 },
 {
  "id": "hjalp-10",
  "text": "Det är svårt. Vi tar det tillsammans.",
  "grupp": "Hjälp"
 },
 {
  "id": "intro-tra",
  "text": "Nu gräver vi trä! Hitta den lilla bokstaven.",
  "grupp": "Berättarrösten"
 },
 {
  "id": "intro-sten",
  "text": "Nu går vi ner i grottan. Lyssna och välj rätt block.",
  "grupp": "Berättarrösten"
 },
 {
  "id": "intro-jarn",
  "text": "Välkommen till järngruvan! Här ljudar vi ihop.",
  "grupp": "Berättarrösten"
 },
 {
  "id": "intro-guld",
  "text": "Guldgruvan! Läs ordet och välj rätt.",
  "grupp": "Berättarrösten"
 },
 {
  "id": "intro-diamant",
  "text": "Diamantgrottan! Nu läser vi meningar.",
  "grupp": "Berättarrösten"
 },
 {
  "id": "klar-tra",
  "text": "Trävåningen är klar!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "klar-sten",
  "text": "Stenvåningen är klar!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "klar-jarn",
  "text": "Järnvåningen är klar!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "klar-guld",
  "text": "Guldvåningen är klar!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "klar-diamant",
  "text": "Diamanttoppen är klar! Slottet är färdigt!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "oppnad-sten",
  "text": "Du har låst upp sten!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "oppnad-jarn",
  "text": "Du har låst upp järn!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "oppnad-guld",
  "text": "Du har låst upp guld!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "oppnad-diamant",
  "text": "Du har låst upp diamant!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "tid-slut",
  "text": "Nu har du spelat klart för i dag. Bra jobbat, Nils! Tornet väntar på dig.",
  "grupp": "Berättarrösten"
 },
 {
  "id": "vinst-jarn",
  "text": "Bra jobbat, Nils! Du fick sex järnblock. Nu kan du bygga!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "vinst-guld",
  "text": "Bra jobbat, Nils! Du fick sex guldblock. Nu kan du bygga!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "vinst-diamant",
  "text": "Bra jobbat, Nils! Du fick sex diamanter. Nu kan du bygga!",
  "grupp": "Berättarrösten"
 },
 {
  "id": "lyssna-valj",
  "text": "Lyssna och välj rätt block.",
  "grupp": "Berättarrösten"
 },
 {
  "id": "las-valj",
  "text": "Läs ordet. Vilket block är rätt?",
  "grupp": "Berättarrösten"
 },
 {
  "id": "las-mening",
  "text": "Läs meningen och välj rätt.",
  "grupp": "Berättarrösten"
 },
